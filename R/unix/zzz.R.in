.onLoad <- function(lib, pkg)
{
    ## Load the rjags wrapper with error info:
    tryCatch ({
      library.dynam("rjags", pkg, lib, local=FALSE)
    }, error = function(e){
      jags.root <- "@JAGS_ROOT@"
      if (file.exists(file.path(jags.root, "bin", "jags"))) {
        stop("An unexpected error occured while linking to the JAGS installation at\n\t", jags.root, "\n\tMake sure that your JAGS installation and R installation are binary\n\tcompatible (your current R platform is ", R.Version()$platform, ").\n\n\tThe error returned from library.dynam(...) was:\n\t", conditionMessage(e), call.=FALSE)
      } else {
        stop("The expected JAGS installation was not found at\n\t", jags.root, "\n\tThe rjags package requires JAGS to be installed on your system.\n\n\tThe error returned from library.dynam(...) was:\n\t", conditionMessage(e), call.=FALSE)
      }
    })

    ## Set the module directory
    if (is.null(getOption("jags.moddir"))) {
        .rjags_env$NULL_MODDIR <- TRUE
        options("jags.moddir" = "@JAGS_MODDIR@")
    }

    ## Try to load the modules with error info:
    tryCatch ({
      load.module("basemod", quiet=TRUE)
      load.module("bugs", quiet=TRUE)
    }, error = function(e){
      jags.moddir <- "@JAGS_MODDIR@"
      if (dir.exists(jags.moddir)) {
        stop("An unexpected error occured while loading rjags modules at\n\t", jags.moddir, "\n\tMake sure that your JAGS installation and R installation are binary\n\tcompatible (your current R platform is ", R.Version()$platform, ").\n\n\tThe error returned from load.module(...) was:\n\t", conditionMessage(e), call.=FALSE)
      } else {
        stop("The expected JAGS module directory was not found at\n\t", jags.moddir, "\n\tYour JAGS installation seems to be broken - maybe reinstall?.\n\n\tThe error returned from load.module(...) was:\n\t", conditionMessage(e), call.=FALSE)
      }
    })

    ## Set progress bar type
    if (is.null(getOption("jags.pb"))) {
        options("jags.pb"="text")
    }
}

.onAttach <- function(lib, pkg)
{
    packageStartupMessage("Linked to JAGS ",
                          .Call("get_version", PACKAGE="rjags"))
    packageStartupMessage("Loaded modules: ",
                          paste(list.modules(), collapse=","))
}

.onUnload <- function(libpath)
{
    library.dynam.unload("rjags", libpath)
    ## Remove the jags.moddir option if we set this at package load
    if(isTRUE(.rjags_env$NULL_MODDIR)) {
      options("jags.moddir" = NULL)
    }
}

### Helper function and package env for pkg.compile.flags
.rjags_env <- new.env(parent = emptyenv())
.rjags_env$NULL_MODDIR <- FALSE

get.compile.flags <- function(){
  list(
    "JAGS_VERSION" = jags.version(),
    "RJAGS_VERSION" = packageVersion("rjags"),
    "JAGS_ROOT" = .Call("get_jags_root", PACKAGE="rjags"),  # Equivalent to @JAGS_ROOT@
    "CPPFLAGS" = .Call("get_rjags_cppflags", PACKAGE="rjags"),
    "CXXFLAGS" = .Call("get_rjags_cxxflags", PACKAGE="rjags"),
    "LIBS" = .Call("get_rjags_libs", PACKAGE="rjags")
  )
}
