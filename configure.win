#!/bin/sh

# Extract the JAGS major number from configue.ac:
if [ -f configure.ac ]; then
  JAGS_MAJOR=$(sed -n 's/^AC_INIT(\[[^]]*\],\[\([0-9]*\)\].*/\1/p' configure.ac)
fi
if [ -z "$JAGS_MAJOR" ]; then
  echo "ERROR: Parsing JAGS_MAJOR from configure.ac failed" >&2
  exit 1
fi

# If JAGS_ROOT is non-empty then convert backslashes to forward slashes and
# strip any trailing version-specific folder:
if [ ! -z "${JAGS_ROOT}" ]; then
  echo "Found env var JAGS_ROOT=${JAGS_ROOT}"

  # TODO: first check for include/version.h in the JAGS_ROOT provided, and
  # if it matches what we need then just use this JAGS_ROOT unmodified

  JAGS_BASE=$(echo "$JAGS_ROOT" | sed 's/\\/\//g' | sed -E 's/\/JAGS-[0-9].*//' | sed -E 's/\/JAGS~[0-9].*//')
  echo "Using JAGS_ROOT=${JAGS_BASE}"
fi

# Otherwise try the following default installation paths, in order:
if [ -z "${JAGS_BASE}" ]; then
  if [ -d "C:/Program Files/JAGS" ]; then
    JAGS_BASE="C:/Program Files/JAGS"
  elif [ -d "C:/Program Files (x86)/JAGS" ]; then
    JAGS_BASE="C:/Program Files (x86)/JAGS"
  else
    echo "ERROR: Could not find a JAGS install directory on your system." >&2
    echo "Please install JAGS ${JAGS_MAJOR}.x.y and/or set JAGS_ROOT manually," >&2
    echo "if you have used a non-standard install location." >&2
    exit 1
  fi
  echo "Using auto-detected JAGS_ROOT=${JAGS_BASE}"
fi

# Get the latest version available (if any):
JAGS_ROOT=""
for dir in "$JAGS_BASE"/JAGS-${JAGS_MAJOR}* "$JAGS_BASE"/JAGS~${JAGS_MAJOR}*; do
  if [ -d "$dir" ]; then
    JAGS_ROOT="$dir"
  fi
done

# Otherwise, fail with an error:
if [ -z "$JAGS_ROOT" ]; then
    echo "ERROR: Could not find a suitable version of JAGS ${JAGS_MAJOR}.x.y" >&2
    echo "under the directory: ${JAGS_BASE}" >&2
    echo "Please install JAGS ${JAGS_MAJOR}.x.y and/or set JAGS_ROOT manually," >&2
    echo "if you have used a non-standard install location." >&2
    exit 1
fi

# Otherwise print an information message and update Makevars.win/ucrt.in:
echo "Found JAGS version ${JAGS_MAJOR} at: $JAGS_ROOT"
sed -e "s|@JAGS_ROOT@|${JAGS_ROOT}|g" src/Makevars.win.in > src/Makevars.win
sed -e "s|@JAGS_ROOT@|${JAGS_ROOT}|g" src/Makevars.ucrt.in > src/Makevars.ucrt

exit 0
