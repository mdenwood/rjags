## Important note for authors of R packages implementing JAGS modules:
## DO NOT copy this file as part of your own package, as we now
## have a simplified configuration mechanism for R packages compiling
## against JAGS and importing rjags.  See the JAGS developer manual.
##    - Matt Denwood, 2026-10-24

# Ensure immediate evaluation of JAGS_ROOT provided by configure.win
JAGS_ROOT := "@JAGS_ROOT@"
JAGS_ROOT_SUBST := $(subst \,/,${JAGS_ROOT})

PKG_LIBS = -L"$(JAGS_ROOT_SUBST)/${R_ARCH}/bin" -ljags-4
PKG_CXXFLAGS =
PKG_CPPFLAGS = -I"$(JAGS_ROOT_SUBST)/include"

PKG_CFLAGS = -DRJAGS_CPPFLAGS='$(PKG_CPPFLAGS)' -DRJAGS_CXXFLAGS='$(PKG_CXXFLAGS)' -DRJAGS_LIBS='$(PKG_LIBS)' -DJAGS_ROOT='$(JAGS_ROOT_SUBST)'
